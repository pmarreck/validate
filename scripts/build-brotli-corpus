 wife wild will willing win wind window wine wing winner winter wipe wire wisdom wise wish with withdraw within without witness woman wonder wonderful wood wooden word work worker working works world worldwide worried worry worst worth would wound wrap write writer writing wrong yard year yellow yes yesterday yet you young youngster your yours yourself youth zone""".split()

# Deterministic LCG (glibc rand parameters); seed fixed for reproducibility.
state = 12345
def step():
	global state
	state = (state * 1103515245 + 12345) & 0xffffffff
	return state

out = []
size = 0
target = 80 * 1024
while size < target:
	sl = 5 + (step() % 18)
	terms = [words[step() % len(words)] for _ in range(sl)]
	s = " ".join(terms).capitalize() + ". "
	out.append(s)
	size += len(s)

with open(out_path, "wb") as f:
	f.write("".join(out).encode("utf-8"))
PY

OUT_BR="$OUT_DIR/realistic_corpus.br"
brotli -q 11 -k -c "$TMP_TXT" > "$OUT_BR"
sz=$(stat -f%z "$OUT_BR" 2>/dev/null || stat -c%s "$OUT_BR" 2>/dev/null)
echo "Wrote $OUT_BR ($sz bytes)"
