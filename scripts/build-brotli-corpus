#!/usr/bin/env bash
# Build the Brotli realistic-corpus ground-truth sample (CC0).
#
# Generates ~80 KB of deterministic pseudo-English text from a 2,300-word
# common-English vocabulary with a multiplicative-congruential RNG, then
# compresses with brotli -q 11 to produce ~27 KB of dense
# Huffman-coded brotli output. This is the corpus that backs the
# ground_truth_examples/br/realistic_corpus.br fixture used by the
# corruption-detection sweep — corruption-experiment(1) detects ~50%
# of single-bit flips and ~100% of 4 KB shotgun overwrites here.
#
# The xorshift random-noise corpus (corpus_xorshift.br) is retained
# alongside as a "fundamental-format-limit" reference: random bytes
# round-trip to ~8 bit/byte Huffman codes that absorb almost all
# bit-flips without surfacing.
#
# Usage: scripts/build-brotli-corpus

set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT_DIR="$ROOT/ground_truth_examples/br"
mkdir -p "$OUT_DIR"

if ! command -v brotli >/dev/null 2>&1; then
	echo "FATAL: brotli CLI not found. Try: nix shell nixpkgs#brotli -c $0" >&2
	exit 1
fi

TMP_TXT="$(mktemp "${TMPDIR:-/tmp}/brotli_corpus.XXXXXX.txt")"
trap 'rm -f "$TMP_TXT"' EXIT

python3 - <<'PY' "$TMP_TXT"
import sys
out_path = sys.argv[1]

# 2,300-word common-English vocabulary
words = """abandon ability able about above accept access account achieve action active activity actor actual add addition address adjust admire admit adopt adult advance advice advise affair affect afford afraid after again against age agency agent ago agree agreement air airport album alcohol alive all allow almost alone along already also alter although always amazing among amount analysis ancient anger animal anniversary another answer anybody anyone anything anyway anywhere apart apartment apologize appear apple application apply appoint approach approve area argue arm army around arrive article artist ask asleep aspect assist assume athlete attach attack attempt attend attention attorney attract audience aunt author authority available avenue average avoid awake award aware away awful baby back background bag balance ball band bank base basic basket bath battle bay beach bear beautiful beauty become bed beer before begin behavior behind belief believe bell belong below belt bench bend benefit beside best better between beyond bicycle bigger bill billion biological birth birthday bitter black blade blame blanket blend blind block blood blow blue board boat body boil bold bomb bone book border born borrow boss both bother bottle bottom bowl boyfriend brain branch brand break breakfast breath breathe brick bridge brief bright bring broad brother brown brush bubble budget build building bullet bunch burden bureau burn bury business busy butter button buyer cable cake calculate calendar camera camp campus cancer candidate cannot canvas capable cape capital captain capture career careful carry castle catch cathedral cause cease celebrate cell century certain chain chair challenge chamber chance chapter character charge charity chart cheap check cheek cheese chemical chest chief child childhood china choice choose chronicle church circle citizen civic civilian claim class classic classroom clean clear clerk client climate climb clock close cloth cloud club coach coast coat code coffee coin cold collapse collect college color column combination combine come comfort coming command comment commercial commission commitment committee common community compete competition complete complex computer concept concern conclude condition conference confirm confront congress connect consider consist constant construct consult consume contact contain content contest context continue contract contrast control conventional conversation convert convict cook cookie copy core corner correct corridor cost cottage council count country couple courage course court cousin cover create credit crime criminal crisis criterion critical critique crop cross crowd crown cruel crystal cultural culture cumulative current curtain custom customer cycle daily damage dance danger daughter dawn deadline deal dear death debate debt decade decide decision declare decline decrease deep defense deficit define definite degree delay delivery demand democracy demonstrate density department departure depend deposit depth describe deserve design desk despair detail detect determine develop device devote diagram dialect dialogue dictate diet differ difference difficult dimension dinner direct director dirty disagree disappear disarm disaster discipline discover discuss disease dismiss display dispute distance distant distinct distribute district disturb diverse divide division divorce doctor document domestic dominate door double doubt downtown dozen draft drag drama drawing dream dress drink drive driver drop drug dry duck due during dust duty each early earn earth ease east easy economic economy edge edit edition editor educate education effect effective effort egg eight eighteen either elect election electric electronic element eleven else email embrace emerge emergency emit emotion employ empty enable encounter encourage end enemy energy enforce engage engine engineer enhance enjoy enormous enough ensure enter enterprise entertain entire entrance entry environment equal equipment error escape especially essay essential establish estate estimate ethnic evaluate evening event eventually ever every everybody everyday everyone everything everywhere evidence evil exact examine example exceed except exchange exciting excuse execute executive exercise exhibit exist expect expense experience experiment expert explain explore export expose express extend external extreme eye fabric face facility fact factor factory fade fail fair faith fall false familiar family famous fancy fantasy farm fashion fast father fault favorite federal fee feed feel female fence festival field fifteen fifth fight figure file fill final finally finance financial find fine finger finish fire firm first fiscal fish fitness five fixed flag flame flash flat flavor flee flexible flight float flood floor flow flower fluid fly focus fold folk follow following food foot football for force foreign forest forever forget form formal former formula forth fortune forty forward foundation four fourth frame freedom frequent fresh friend friendly frog from front fruit fuel fully fun function fund funeral funny furniture future gain galaxy gallery game garage garbage garden gas gate gather gear gene general generate generation genetic genius genre gentle gentleman genuine geography ghost giant gift girl give glance glass global glory go goal good gospel govern government governor grab grade gradual graduate grain grand grandfather grandmother grant grass gray great green greet grocery ground group grow growth guarantee guard guess guest guide guilty guitar habit hair half hallway hammer hand handful handle hang happen happy hard hardly hate have he head headline heal health hear heart heat heaven heavy height help hence her here heritage hero herself hide high highlight highway hill himself hint hip hire history hit hold hole holiday hollow holy home homework honest honey honor hook hope horizon horror horse hospital host hotel hour house household housing how however huge human h