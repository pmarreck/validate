#!/usr/bin/env bash
set -uo pipefail
set -E

trap 'echo "ERR at ${BASH_SOURCE[0]}:${LINENO}: $BASH_COMMAND" >&2' ERR

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

run() {
  "$@" || {
    echo "FAILED: $*" >&2
    exit 1
  }
}

# Dependency freshness gate (Peter 2026-08-27): the build FAILS when any
# build.zig.zon pin is behind its upstream head, unless VALIDATE_ALLOW_STALE
# is truthy — which prints an unmissable advisory requiring Peter's
# authorization. Offline falls back to local sibling repos. Runs OUTSIDE the
# nix sandbox by necessity (network); Mechatron's flake targets are
# unaffected. Gated by tests/cli/dep_freshness.
run "$SCRIPT_DIR/scripts/check-dep-freshness"

optimize="ReleaseFast"
if [[ "${1:-}" == "debug" ]]; then
  optimize="Debug"
  shift
fi

if [[ "$optimize" != "ReleaseFast" ]]; then
  # Non-release builds use zig directly (local dev, no need for Nix reproducibility)
  run zig build "-Doptimize=$optimize" "$@"
elif command -v nix >/dev/null 2>&1; then
  run nix build "$@"
  run "$SCRIPT_DIR/scripts/sync-nix-result-to-zig-out" result zig-out/bin
else
  run zig build "-Doptimize=$optimize" "$@"
fi
