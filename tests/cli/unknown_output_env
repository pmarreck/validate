#!/usr/bin/env bash

set -u

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/validate_cli_unknown_env.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

printf '\x00\xff\x00\xff\x01\x02\x03\x04' > "$tmpdir/unknown.bin"

unknown_path="$tmpdir/unknown.out"
output=$(UNKNOWN_OUT="$unknown_path" ./zig-out/bin/validate "$tmpdir/unknown.bin" 2>&1) || true

if echo "$output" | grep -q "UNKNOWN"; then
	printf 'FAIL: did not expect UNKNOWN in stdout/stderr when UNKNOWN_OUT is set\n' >&2
	printf 'output:\n%s\n' "$output" >&2
	exit 1
fi

if [ ! -f "$unknown_path" ]; then
	printf 'FAIL: expected %s to exist\n' "$unknown_path" >&2
	exit 1
fi

if ! grep -q "UNKNOWN" "$unknown_path"; then
	printf 'FAIL: expected UNKNOWN in %s\n' "$unknown_path" >&2
	printf 'file contents:\n%s\n' "$(cat "$unknown_path")" >&2
	exit 1
fi
