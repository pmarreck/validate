#!/usr/bin/env bash
set -u

if [[ -x "./zig-out/bin/validate" ]]; then
	BIN="./zig-out/bin/validate"
elif [[ -x "./zig-out/bin/validate.exe" ]]; then
	BIN="./zig-out/bin/validate.exe"
else
	echo "FAIL: validate binary not found (tried ./zig-out/bin/validate and .exe)"
	exit 1
fi

if [[ ! -f "ground_truth_examples/cpt/sample.cpt" ]]; then
	echo "FAIL: missing ground truth sample at ground_truth_examples/cpt/sample.cpt"
	exit 1
fi

for i in 1 2 3 4 5; do
	if [[ ! -f "ground_truth_examples/corrupted/cpt/sample_corrupt_${i}.cpt" ]]; then
		echo "FAIL: missing corrupted sample ground_truth_examples/corrupted/cpt/sample_corrupt_${i}.cpt"
		exit 1
	fi
done

strip_ansi() {
	sed 's/\x1b\[[0-9;]*m//g'
}

failures=0

echo "Test 1: valid CPT sample must validate"
valid_out=$("$BIN" --no-color "ground_truth_examples/cpt/sample.cpt" 2>&1 | strip_ansi) || true
if echo "$valid_out" | grep -qE '^(OK|WARN).*Compact Pro Archive'; then
	echo "  PASS: valid sample accepted"
else
	echo "  FAIL: valid sample rejected"
	echo "  Output: $valid_out"
	((failures++)) || true
fi

echo "Test 2: deterministic corruption set must fail"
for i in 1 2 3 4 5; do
	path="ground_truth_examples/corrupted/cpt/sample_corrupt_${i}.cpt"
	corrupt_out=$("$BIN" --no-color "$path" 2>&1 | strip_ansi) || true
	if echo "$corrupt_out" | grep -qE '^FAIL.*Compact Pro Archive'; then
		echo "  PASS: corrupt sample ${i} rejected"
	else
		echo "  FAIL: corrupt sample ${i} was not rejected"
		echo "  Output: $corrupt_out"
		((failures++)) || true
	fi
done

if [[ "$failures" -ne 0 ]]; then
	echo "CPT validation tests failed: $failures"
	exit "$failures"
fi

echo "CPT validation tests passed"
