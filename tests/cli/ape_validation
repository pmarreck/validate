#!/usr/bin/env bash
# Monkey's Audio (APE) deep decode + structural validation CLI tests.
#
# Detection scope after MAC SDK 12.73 vendor:
#   - Header field corruption (compression, channels, sample_rate, BPS,
#     totalframes, final_frame_blocks, seek_table_length): 100% via
#     structural rigor (every byte through descriptor + header + seek table)
#   - Seek-table monotonicity / out-of-bounds: 100% structural
#   - Magic / version corruption: 100% structural
#   - Mid-frame bit flips inside the compressed bitstream: caught by the
#     full Monkey's Audio decoder verifying per-frame CRC32 over
#     decoded PCM (per APEDecompressCore::EndFrame in the upstream SDK)
#   - Truncation: caught either by structural seek-table walk or by the
#     decoder's nBytesLeft != 0 path which propagates as decode failure
#
# Spec reference: official Monkey's Audio SDK at https://monkeysaudio.com,
#   shipped as deps/libape under BSD-3.

set -u

. "$(dirname "$0")/_lib.sh"

BIN="${VALIDATE_BIN:-./zig-out/bin/validate}"
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
	if [[ ! -x "$BIN" ]]; then BIN="./zig-out/bin/validate.exe"; fi
fi
if [[ ! -x "$BIN" ]]; then
	echo "FAIL: validate binary not found at $BIN"
	exit 1
fi

PASS=0
FAIL=0

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	FAIL=$((FAIL + 1))
}
pass() {
	printf '  PASS: %s\n' "$1"
	PASS=$((PASS + 1))
}

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/validate_ape_test.XXXXXX")"
trap 'mv "$tmpdir" ~/.Trash/ 2>/dev/null || rm -rf "$tmpdir"' EXIT

# Pick the largest available sample to exercise both structural and
# decode probes meaningfully.
SAMPLE=""
for cand in \
	ground_truth_examples/ape/sample.ape \
	ground_truth_examples/ape/corpus_synthetic.ape
do
	if [[ -f "$cand" ]]; then
		SAMPLE="$cand"
		break
	fi
done
if [[ -z "$SAMPLE" ]]; then
	echo "SKIP: no APE ground-truth sample available"
	exit 0
fi

# Pre-flight: clean sample must validate AND report (fully validated).
clean_out="$("$BIN" "$SAMPLE" 2>&1 || true)"
if grep -qE '(fully validated)' <<<"$clean_out"; then
	pass "clean APE reports (fully validated)"
else
	fail "clean APE did not report (fully validated): $clean_out"
fi
if "$BIN" "$SAMPLE" >/dev/null 2>&1; then
	pass "clean APE validates (exit 0)"
else
	fail "clean APE unexpectedly rejected: $SAMPLE"
	echo ""
	echo "Results: $PASS passed, $FAIL failed"
	exit "$FAIL"
fi

sz=$(stat -f%z "$SAMPLE" 2>/dev/null || stat -c%s "$SAMPLE" 2>/dev/null)
if [[ "${sz:-0}" -lt 12288 ]]; then
	echo "  NOTE: APE sample is ${sz}B (< 12 KB) — skipping corruption probes"
	echo ""
	echo "Results: $PASS passed, $FAIL failed"
	exit "$FAIL"
fi

read_byte() {
	local file="$1" off="$2" byte
	byte=$(od -An -tu1 -j "$off" -N1 "$file" | tr -d '[:space:]')
	if [[ -z "$byte" ]]; then
		printf 'read_byte failed at offset %s in %s\n' "$off" "$file" >&2
		return 1
	fi
	printf '%s\n' "$byte"
}

write_byte() {
	local file="$1" off="$2" val="$3" hex
	printf -v hex '%02x' "$((val & 0xff))"
	mutate_bytes "$file" "$off" "$hex"
}

flip_byte() {
	local file="$1" off="$2" orig
	orig=$(read_byte "$file" "$off") || return 1
	write_byte "$file" "$off" "$((orig ^ 0xff))"
}

# Helper: write a u32 LE at given offset in a copy. One mutate_bytes call for
# the whole field: the changed-vs-original proof must span the field, since
# individual bytes (e.g. high bytes of small values) often already match.
write_u32_le() {
	local file="$1" off="$2" val="$3" b0 b1 b2 b3
	printf -v b0 '%02x' "$((val & 0xff))"
	printf -v b1 '%02x' "$(((val >> 8) & 0xff))"
	printf -v b2 '%02x' "$(((val >> 16) & 0xff))"
	printf -v b3 '%02x' "$(((val >> 24) & 0xff))"
	mutate_bytes "$file" "$off" "$b0" "$b1" "$b2" "$b3"
}

write_u16_le() {
	local file="$1" off="$2" val="$3" b0 b1
	printf -v b0 '%02x' "$((val & 0xff))"
	printf -v b1 '%02x' "$(((val >> 8) & 0xff))"
	mutate_bytes "$file" "$off" "$b0" "$b1"
}

read_u16_le() {
	local file="$1" off="$2" b0 b1
	b0=$(read_byte "$file" "$off") || return 1
	b1=$(read_byte "$file" "$((off + 1))") || return 1
	printf '%d\n' "$((b0 | (b1 << 8)))"
}

# Detect file version to pick correct field offsets.
version=$(read_u16_le "$SAMPLE" 4)

if [[ "$version" -ge 3980 ]]; then
	echo "  detected modern APE (v${version})"
	OFF_COMPRESSION=52
	OFF_CHANNELS=70
	OFF_SAMPLE_RATE=72
	OFF_TOTAL_FRAMES=64
else
	echo "  detected legacy APE (v${version})"
	OFF_COMPRESSION=6
	OFF_CHANNELS=10
	OFF_SAMPLE_RATE=12
	OFF_TOTAL_FRAMES=24
fi

# 1. Bogus compression_type (must be 1000/2000/3000/4000/5000)
bogus_comp="$tmpdir/bogus_comp.ape"
cp "$SAMPLE" "$bogus_comp"
write_u16_le "$bogus_comp" "$OFF_COMPRESSION" 1234
if ! "$BIN" "$bogus_comp" >/dev/null 2>&1; then
	pass "bogus compression_type (1234) rejected"
else
	fail "bogus compression_type (1234) accepted"
fi

# 2. Bogus channel count (must be 1 or 2)
bogus_ch="$tmpdir/bogus_ch.ape"
cp "$SAMPLE" "$bogus_ch"
write_u16_le "$bogus_ch" "$OFF_CHANNELS" 99
if ! "$BIN" "$bogus_ch" >/dev/null 2>&1; then
	pass "bogus channels (99) rejected"
else
	fail "bogus channels (99) accepted"
fi

# 3. Bogus sample rate (out of plausible 4kHz..384kHz)
bogus_sr="$tmpdir/bogus_sr.ape"
cp "$SAMPLE" "$bogus_sr"
write_u32_le "$bogus_sr" "$OFF_SAMPLE_RATE" 999999999
if ! "$BIN" "$bogus_sr" >/dev/null 2>&1; then
	pass "bogus sample_rate (999999999) rejected"
else
	fail "bogus sample_rate (999999999) accepted"
fi

# 4. Bogus total_frames (zero is invalid)
bogus_tf="$tmpdir/bogus_tf.ape"
cp "$SAMPLE" "$bogus_tf"
write_u32_le "$bogus_tf" "$OFF_TOTAL_FRAMES" 0
if ! "$BIN" "$bogus_tf" >/dev/null 2>&1; then
	pass "zero total_frames rejected"
else
	fail "zero total_frames accepted"
fi

# 5. Magic byte corruption — must be rejected
bad_magic="$tmpdir/bad_magic.ape"
cp "$SAMPLE" "$bad_magic"
write_byte "$bad_magic" 1 88
if ! "$BIN" "$bad_magic" >/dev/null 2>&1; then
	pass "MAC magic byte corruption rejected"
else
	fail "MAC magic byte corruption accepted"
fi

# 6. Version corruption — version > 3990 must be rejected
bad_ver="$tmpdir/bad_ver.ape"
cp "$SAMPLE" "$bad_ver"
write_u16_le "$bad_ver" 4 9999
if ! "$BIN" "$bad_ver" >/dev/null 2>&1; then
	pass "version > 3990 rejected"
else
	fail "version > 3990 accepted"
fi

# 7. Mid-frame bit flip in the compressed bitstream — only the decoder
# can catch this (per-frame CRC over decoded PCM).
mid_flip="$tmpdir/mid_flip.ape"
cp "$SAMPLE" "$mid_flip"
flip_off=$((sz - 2000))
flip_byte "$mid_flip" "$flip_off"
if ! "$BIN" "$mid_flip" >/dev/null 2>&1; then
	pass "mid-frame bit flip detected (per-frame CRC32-over-PCM)"
else
	fail "mid-frame bit flip silently accepted"
fi

# 8. Shotgun 4 KB random overwrite at midpoint
shotgun="$tmpdir/shotgun.ape"
cp "$SAMPLE" "$shotgun"
mid=$((sz / 2))
mutate_bytes_from "$shotgun" "$mid" /dev/urandom 4096
if ! "$BIN" "$shotgun" >/dev/null 2>&1; then
	pass "4 KB shotgun-corrupted APE detected"
else
	fail "4 KB shotgun-corrupted APE silently accepted"
fi

# 9. Truncation — chop off last 1KB. Either the seek-table walk catches
# it (modern files have audio_data_length, so EOF detection fires) or
# the decoder's "decoded sample count mismatch" path catches it.
truncated="$tmpdir/truncated.ape"
head -c $((sz - 1024)) "$SAMPLE" > "$truncated"
if ! "$BIN" "$truncated" >/dev/null 2>&1; then
	pass "truncated APE detected"
else
	fail "truncated APE silently accepted"
fi

echo ""
echo "Results: $PASS passed, $FAIL failed"
exit "$FAIL"
