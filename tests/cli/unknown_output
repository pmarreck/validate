#!/usr/bin/env bash

set -euo pipefail

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/validate_cli_unknown.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

printf '\x00\xff\x00\xff\x01\x02\x03\x04' > "$tmpdir/unknown.bin"

unset UNKNOWN_OUT
output=$(./zig-out/bin/validate "$tmpdir/unknown.bin" 2>&1) || true

if ! echo "$output" | grep -q "UNKNOWN"; then
	printf 'FAIL: expected UNKNOWN output\n' >&2
	printf 'output:\n%s\n' "$output" >&2
	exit 1
fi
