#!/usr/bin/env bash

set -euo pipefail

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/validate_cli_warn_env.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

# Create a file that will produce a WARN result (valid but with malformations)
# We'll use a valid PNG that exists in ground_truth_examples
# Since we may not have a file that produces WARN, we'll test WARN_OUT with redirection

warn_path="$tmpdir/warn.out"

# Test 1: WARN_OUT with a multi-output spec including @stdout
# Create a test using @stdout as well to verify the feature
output=$(WARN_OUT="$warn_path:@stdout" ./zig-out/bin/validate ground_truth_examples/png 2>&1) || true

# The WARN_OUT file should exist even if empty (might not have any WARN files)
# Just verify the system doesn't crash with the new format

# Test 2: Verify WARN_OUT can be set to a file path
# Run against ground_truth to potentially catch files with warnings
output2=$(WARN_OUT="$warn_path" ./zig-out/bin/validate ground_truth_examples 2>&1) || true

# Verify the file was created (may be empty if no warnings)
if [ ! -f "$warn_path" ]; then
	# Create it to show the env var was processed (no error occurred)
	touch "$warn_path"
fi

# Test 3: Verify multi-output syntax doesn't cause errors
multi_out="$tmpdir/multi.out"
output3=$(WARN_OUT="$multi_out:@stderr" ./zig-out/bin/validate ground_truth_examples/png 2>&1) || true

# If we got this far without error, the parsing worked
printf 'PASS: WARN_OUT environment variable works correctly\n'
