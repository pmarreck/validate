#!/usr/bin/env bash
# WavPack deep-decode validation CLI tests.
#
# WavPack stores a 32-bit CRC per block, computed over the DECODED PCM
# samples (per dbry's reference unpack.c line 508). The validator wires
# libwavpack 5.9.0 to decode every block and surface mismatches via
# WavpackGetNumErrors. Truncation and block-checksum sub-block failures
# also get flagged.
#
# Detection profile (empirically, on a 120 KB lossless corpus):
#   - sniper (single-bit flip): >95% — block-CRC over decoded samples
#     amplifies almost every flip into a mismatch. Header bytes flips
#     also caught by libwavpack's open-time block validator.
#   - shotgun (4 KB overwrite): ~100% — 4 KB obliterates at least one
#     full block; checksum sub-block + post-decode CRC + sample-count
#     drift all conspire to reject.

set -u

BIN="${VALIDATE_BIN:-./zig-out/bin/validate}"
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
	if [[ ! -x "$BIN" ]]; then BIN="./zig-out/bin/validate.exe"; fi
fi
if [[ ! -x "$BIN" ]]; then
	echo "FAIL: validate binary not found at $BIN"
	exit 1
fi

PASS=0
FAIL=0

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	FAIL=$((FAIL + 1))
}

pass() {
	printf '  PASS: %s\n' "$1"
	PASS=$((PASS + 1))
}

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/validate_wavpack_test.XXXXXX")"
trap 'mv "$tmpdir" ~/.Trash/ 2>/dev/null || rm -rf "$tmpdir"' EXIT

# Prefer the corpus_xorshift.wv sample (≥ 12 KB, lossless, multi-block).
# Fall back to the tiny sample.wv for clean-path coverage only.
SAMPLE=""
for cand in \
	ground_truth_examples/wavpack/corpus_xorshift.wv \
	ground_truth_examples/wavpack/sample.wv
do
	if [[ -f "$cand" ]]; then
		sz=$(stat -f%z "$cand" 2>/dev/null || stat -c%s "$cand" 2>/dev/null)
		if [[ "${sz:-0}" -ge 12288 ]]; then
			SAMPLE="$cand"
			break
		fi
		[[ -z "$SAMPLE" ]] && SAMPLE="$cand"
	fi
done

if [[ -z "$SAMPLE" ]]; then
	echo "SKIP: no WavPack ground-truth sample"
	exit 0
fi

# 1. Clean sample must validate (and report fully validated, not structural).
clean_out="$("$BIN" "$SAMPLE" 2>&1 || true)"
if grep -qE '(fully validated)' <<<"$clean_out"; then
	pass "clean WavPack stream reports (fully validated)"
else
	fail "clean WavPack stream did not report (fully validated): $clean_out"
fi
if "$BIN" "$SAMPLE" >/dev/null 2>&1; then
	pass "clean WavPack stream validates (exit 0)"
else
	fail "clean WavPack stream unexpectedly rejected: $SAMPLE"
fi

sz=$(stat -f%z "$SAMPLE" 2>/dev/null || stat -c%s "$SAMPLE" 2>/dev/null)
if [[ "${sz:-0}" -lt 12288 ]]; then
	echo "  NOTE: sample is ${sz}B (< 12 KB) — skipping corruption probes"
	echo ""
	echo "Results: $PASS passed, $FAIL failed"
	exit "$FAIL"
fi

read_byte() {
	local file="$1" off="$2" byte
	byte=$(od -An -tu1 -j "$off" -N1 "$file" | tr -d '[:space:]')
	if [[ -z "$byte" ]]; then
		printf 'read_byte failed at offset %s in %s\n' "$off" "$file" >&2
		return 1
	fi
	printf '%s\n' "$byte"
}

read_u32_le() {
	local file="$1" off="$2" b0 b1 b2 b3
	b0=$(read_byte "$file" "$off") || return 1
	b1=$(read_byte "$file" "$((off + 1))") || return 1
	b2=$(read_byte "$file" "$((off + 2))") || return 1
	b3=$(read_byte "$file" "$((off + 3))") || return 1
	printf '%d\n' "$((b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)))"
}

write_byte() {
	local file="$1" off="$2" val="$3" oct
	printf -v oct '%03o' "$((val & 0xff))"
	printf "\\$oct" | dd of="$file" bs=1 seek="$off" conv=notrunc 2>/dev/null
}

flip_byte() {
	local file="$1" off="$2" orig
	orig=$(read_byte "$file" "$off") || return 1
	write_byte "$file" "$off" "$((orig ^ 0xff))"
}

# 2. Mid-stream single-byte flip in the bitstream payload of block 3
#    (offset ~50 KB in the corpus) must be caught.
mid_flip="$tmpdir/mid_flip.wv"
cp "$SAMPLE" "$mid_flip"
flip_off=$((sz / 2 + 100))
flip_byte "$mid_flip" "$flip_off"
if ! "$BIN" "$mid_flip" >/dev/null 2>&1; then
	pass "mid-block byte flip detected"
else
	fail "mid-block byte flip silently accepted"
fi

# 3. Block-header CRC field tamper. The header CRC at offset+28 (each
#    block) is checked post-decode against recomputed CRC over PCM.
#    Tampering it forces a mismatch even if the bitstream is intact.
hdr_tamper="$tmpdir/hdr_tamper.wv"
cp "$SAMPLE" "$hdr_tamper"
# Find second block start. Block 1 is at offset 0; block_size is at offset 4 (u32 LE)
# so block 2 starts at 8 + block_size.
block_size=$(read_u32_le "$hdr_tamper" 4)
block2_start=$((8 + block_size))
crc_off=$((block2_start + 28))
flip_byte "$hdr_tamper" "$crc_off"
if ! "$BIN" "$hdr_tamper" >/dev/null 2>&1; then
	pass "block-header CRC field tamper detected"
else
	fail "block-header CRC field tamper silently accepted"
fi

# 4. Shotgun 4 KB random overwrite at midpoint must be caught.
mid=$((sz / 2))
shotgun="$tmpdir/shotgun.wv"
cp "$SAMPLE" "$shotgun"
dd if=/dev/urandom of="$shotgun" bs=1 seek="$mid" count=4096 conv=notrunc 2>/dev/null
if ! "$BIN" "$shotgun" >/dev/null 2>&1; then
	pass "4 KB shotgun-corrupted WavPack detected"
else
	fail "4 KB shotgun-corrupted WavPack silently accepted"
fi

# 5. Truncation: drop last 64 bytes, decoder should report mismatch.
truncated="$tmpdir/truncated.wv"
head -c $((sz - 64)) "$SAMPLE" > "$truncated"
if ! "$BIN" "$truncated" >/dev/null 2>&1; then
	pass "truncated WavPack stream detected"
else
	fail "truncated WavPack stream silently accepted"
fi

echo ""
echo "Results: $PASS passed, $FAIL failed"
exit "$FAIL"
