#!/usr/bin/env bash

set -euo pipefail

BIN="./zig-out/bin/validate"

# Test Unix-style help switches
for switch in "--help" "-h"; do
	output=$($BIN $switch 2>&1) || true
	if ! echo "$output" | grep -q "USAGE:"; then
		printf 'FAIL: %s did not show usage\n' "$switch" >&2
		exit 1
	fi
done

# Test Windows-style help switches (accepted on all platforms)
for switch in "/help" "/h" "/?"; do
	output=$($BIN $switch 2>&1) || true
	if ! echo "$output" | grep -q "USAGE:"; then
		printf 'FAIL: %s did not show usage\n' "$switch" >&2
		exit 1
	fi
done

# Test version switches
for switch in "--version" "/version"; do
	output=$($BIN $switch 2>&1) || true
	if ! echo "$output" | grep -qE "^[0-9]+\.[0-9]+"; then
		printf 'FAIL: %s did not show version\n' "$switch" >&2
		printf 'output: %s\n' "$output" >&2
		exit 1
	fi
done

printf 'PASS: All help and version switches work\n'
