#!/usr/bin/env bash

set -euo pipefail

BIN="./zig-out/bin/validate"

# Test Unix-style help switches (work on all platforms)
for switch in "--help" "-h"; do
	output=$($BIN $switch 2>&1) || true
	if ! echo "$output" | grep -q "USAGE:"; then
		printf 'FAIL: %s did not show usage\n' "$switch" >&2
		exit 1
	fi
done

# Test Unix-style version switch
output=$($BIN --version 2>&1) || true
if ! echo "$output" | grep -qE "^[0-9]+\.[0-9]+"; then
	printf 'FAIL: --version did not show version\n' >&2
	printf 'output: %s\n' "$output" >&2
	exit 1
fi

# Test Windows-style switches only on Windows
# Note: MSYS_NO_PATHCONV prevents Git Bash from converting /help to a Windows path
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
	export MSYS_NO_PATHCONV=1
	export MSYS2_ARG_CONV_EXCL="*"

	for switch in "/help" "/h" "/?"; do
		output=$($BIN $switch 2>&1) || true
		if ! echo "$output" | grep -q "USAGE:"; then
			printf 'FAIL: %s did not show usage\n' "$switch" >&2
			printf 'output was: %s\n' "$output" >&2
			exit 1
		fi
	done

	output=$($BIN /version 2>&1) || true
	if ! echo "$output" | grep -qE "^[0-9]+\.[0-9]+"; then
		printf 'FAIL: /version did not show version\n' >&2
		printf 'output: %s\n' "$output" >&2
		exit 1
	fi

	printf 'PASS: Windows-style switches work\n'
fi

printf 'PASS: All help and version switches work\n'
