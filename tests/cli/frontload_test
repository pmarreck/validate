#!/usr/bin/env bash

set -u

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	exit 1
}

tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/validate_cli_frontload.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT
mkdir "$tmpdir/in"

# Fourteen valid text files ensure the default scatter path executes (>10),
# with an unambiguous top-size group at P90: twelve 100-byte files and two
# 100-KiB files. Keep result output outside the scanned tree.
for i in $(seq 1 12); do
	head -c 100 /dev/zero | tr '\0' 'a' >"$tmpdir/in/small_$i.txt"
done
for i in $(seq 1 2); do
	head -c 102400 /dev/zero | tr '\0' 'b' >"$tmpdir/in/large_$i.txt"
done

extract_paths() {
	sed -nE 's@^OK .*/(small|large)_([0-9]+)\.txt:.*@\1_\2@p' "$1"
}

# Jobs=1 makes callback completion order equal the selected queue order.
default_order="$tmpdir/default-order.out"
if ! VALIDATE_DEBUG=1 OK_OUT="$default_order" "$VALIDATE_BIN" --jobs 1 "$tmpdir/in" \
	>"$tmpdir/default.stdout" 2>"$tmpdir/default.stderr"; then
	fail 'default scattered validation returned non-zero'
fi

if ! grep -q '\[DEBUG\] Scatter: 2 large files' "$tmpdir/default.stderr"; then
	fail 'default run did not enter the two-large-file scatter path'
fi

default_paths="$(extract_paths "$default_order")"
if [ "$(printf '%s\n' "$default_paths" | sed '/^$/d' | wc -l)" -ne 14 ]; then
	fail 'default scatter did not emit one result for every input'
fi
if [ "$(printf '%s\n' "$default_paths" | sort -u | wc -l)" -ne 14 ]; then
	fail 'default scatter emitted a duplicate or omitted a path'
fi

large_lines="$(printf '%s\n' "$default_paths" | grep -n '^large_' | cut -d: -f1)"
if [ "$(printf '%s\n' "$large_lines" | sed '/^$/d' | wc -l)" -ne 2 ]; then
	fail 'default scatter did not preserve both large-file memberships'
fi
first_large="$(printf '%s\n' "$large_lines" | sed -n '1p')"
second_large="$(printf '%s\n' "$large_lines" | sed -n '2p')"
if [ $((second_large - first_large)) -le 1 ]; then
	fail 'default scatter placed the two large files adjacently'
fi

# --no-frontload must preserve exact validation coverage even though it leaves
# discovery order untouched.
plain_order="$tmpdir/plain-order.out"
if ! OK_OUT="$plain_order" "$VALIDATE_BIN" --jobs 1 --no-frontload "$tmpdir/in" \
	>"$tmpdir/plain.stdout" 2>"$tmpdir/plain.stderr"; then
	fail '--no-frontload validation returned non-zero'
fi
plain_paths="$(extract_paths "$plain_order")"
if [ "$(printf '%s\n' "$plain_paths" | sort -u)" != "$(printf '%s\n' "$default_paths" | sort -u)" ]; then
	fail '--no-frontload changed result membership'
fi

help_output=$("$VALIDATE_BIN" --help 2>&1) || fail '--help returned non-zero'
for token in no-frontload simple-progress OK_OUT WARN_OUT; do
	if ! printf '%s\n' "$help_output" | grep -q "$token"; then
		fail "--help is missing $token"
	fi
done

printf 'PASS: default scatter and --no-frontload preserve all 14 results\n'
