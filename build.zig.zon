.{
    .name = .validate,
    .version = "0.16.0",
    .dependencies = .{
        .toml = .{
            .url = "git+https://github.com/sam701/zig-toml?ref=HEAD#24e0deeceaad1b7f1b12027ebae1c65ff1d86e33",
            .hash = "toml-0.3.0-bV14BVqIAQANb68hDuVPZ72hrcIhT-fv_fcIbetQIAyg",
        },
        .@"zig-xml" = .{
            .url = "git+https://github.com/ianprime0509/zig-xml#b97f2ab4868ae3cac9902b33a40d3f31d2df739d",
            .hash = "xml-0.2.0-ZTbP3yI6AgB9Rpd2hQrueO63ib0Bm6mQiL_WB1t7JAmP",
        },
        .zigimg = .{
            .url = "git+https://github.com/pmarreck/zigimg#12e5dc934b92b2d0ef5481c1f67f1346f3a365e0",
            .hash = "zigimg-0.1.0-8_eo2lO2FwC3lfMxQB9Y2FPr9vA9Y7Vunf5LjdoZ2NQB",
        },
        .libwebp = .{
            .path = "deps/libwebp",
        },
        // Removed: libheif, libde265, dav1d, openh264 (replaced by pure-Zig validators)
        .libopus = .{
            .path = "deps/libopus",
        },
        .libogg = .{
            .path = "deps/libogg",
        },
        .libvorbis = .{
            .path = "deps/libvorbis",
        },
        .libtheora = .{
            .path = "deps/libtheora",
        },
        .minimp3 = .{
            .path = "deps/minimp3",
        },
        .libvpx = .{
            .path = "deps/libvpx",
        },
        .libwavpack = .{
            .path = "deps/libwavpack",
        },
        .libape = .{
            .path = "deps/libape",
        },
        // openjpeg removed (v1 closure cutover): JP2 validation is pure-Zig
        // via tiffz.jpegz (jp2z). jpegz's decode path still references
        // openjpeg until it gates that linkage; that copy is jpegz's own.
        // libjxlz: no longer a direct dep. jpegz (via tiffz) pins the same
        // libjxlz commit and re-exposes strict JXL validation through
        // `tiffz.jpegz.jpegxl` — a second direct pin here created two module
        // instances of the same root file, which Zig 0.16 rejects (same class
        // of failure as jpegz itself, see the tiffz comment below / #32).
        .brotli = .{
            .path = "deps/brotli",
        },
        .pcre2 = .{
            .url = "https://github.com/pmarreck/pcre2/archive/refs/tags/zig-0.16.0.tar.gz",
            .hash = "pcre2-10.47.0-S7QTbvnVMgDsA1ipkKNj5kVoEda9wcIuZYUpdrTuDaCh",
        },
        .zlib = .{
            // Pinned to immutable commit (was refs/heads/main; moving branches
            // drift and break CI — see sqlite3 2026-06-05).
            .url = "https://github.com/allyourcodebase/zlib/archive/d3b5519d3b73616a6bfece0712f080029d2a9244.tar.gz",
            .hash = "zlib-1.3.2-ZZQ7lc8NAAAHm9MDfplvwoesXvk4tVm6VCsiI8KnIbT0",
        },
        .sqlite3 = .{
            // Pinned to an immutable commit (was refs/heads/main, which drifted
            // 3.51.0 -> 3.53.2 and broke CI on 2026-06-05). Pin SHA, not a branch.
            .url = "https://github.com/allyourcodebase/sqlite3/archive/7a615f5af79009cd733e3480658586d9b0d28b35.tar.gz",
            .hash = "sqlite3-3.53.2-DMxLWuAOAAA_Px0arJOIOaP4AKEu5prbsQgPMA35W1zz",
        },
        .libopenmpt = .{
            // Pinned to immutable commit (was refs/heads/master).
            .url = "https://github.com/pmarreck/openmpt/archive/4066adfb77c095ac9f5d3437448fdcefb6a77e92.tar.gz",
            .hash = "libopenmpt-0.8.0-5ozQWN9GGQt4jdD0toz0qfceXIERnEsx5vBcUvWUg60E",
        },
        .cj5 = .{
            .url = "git+https://github.com/pmarreck/cj5#b70941c4fe022df55a4177f696b0474ba3ef8125",
            .hash = "cj5-1.0.0-wO-em1zcAADAeO71NFuI_Z-cmq7BT-0YSVegGQ2q8SCe",
        },
        // libraw removed (v1 closure, 2026-08-15): oracle-only per Peter's
        // ruling — ARW/CR2/NEF route tiffz+jpegz; vendor sensor payloads are
        // rawz milestones. darktable/rawspeed/libraw remain dev/test oracles
        // OUTSIDE the build graph.
        .z7z = .{
            .url = "git+https://github.com/pmarreck/z7z#d495452c79d322b9691a64da4ac733a441df4de5",
            .hash = "z7z-0.1.0-rkKuF6ZyCAD-5nqCC5Yp3bXxVeKoBWXDlflM2virwmOY",
        },
        .rarz = .{
            .url = "https://github.com/pmarreck/rarz/archive/bf6840ce597cc4be9bdbfafda5722868b87d92d9.tar.gz",
            .hash = "rarz-0.1.0-BNfrfqcnDQAy0gWeA80xxXVRttkUI3KGtmCIG-Wr0Qp8",
        },
        .bzip2z = .{
            .url = "https://github.com/pmarreck/bzip2z/archive/9b9e28dafb8dc3d34a88d43b7359b6ca9efd78f1.tar.gz",
            .hash = "bzip2z-0.1.0-m5NdlsYYCACrnvOCZyqsVmJYY84BRf1XPFi08RfbnWPW",
        },
        .zstdz = .{
            .url = "https://github.com/pmarreck/zstdz/archive/46a916ab3bb24c2298f1559a1b36691caab53ffa.tar.gz",
            .hash = "zstdz-1.6.0-yDWjzjJvNADuXVquo1ire6azJM7pPcP-DIqOXWGsLr6G",
        },
        .par2z = .{
            .url = "https://github.com/pmarreck/par2z/archive/6c97a8e7d60067f81001afe7634836c2cb2c10ab.tar.gz",
            .hash = "par2z-0.1.0-KhX3fThrBgCWLRmns254lM9DMuqkaJwurDz84iqeU3fb",
        },
        .uchardetz = .{
            .url = "https://github.com/pmarreck/uchardetz/archive/10cb89fae7882b46fdfecfd4aa2751989d1e9aab.tar.gz",
            .hash = "uchardetz-0.0.6-koAyw7pFCwAzXYaKhsirPcnwf7wfPYm8B8UCRkNc2WbD",
        },
        .compact_pro = .{
            .url = "https://github.com/pmarreck/compact_pro/archive/813ef896c4b1b145e7c0b461a4f87301b0a2c6db.tar.gz",
            .hash = "compact_pro-0.1.0-G2wo9UzmAgD8tLdmff1PI_Vj6N0pip0SWSi9oAfGeOMa",
        },
        .progrez = .{
            .url = "git+https://github.com/pmarreck/progrez#7d70ce836108b761ffbeb6f2d4908a5fb9506ca6",
            .hash = "progrez-0.1.0-0YJXrpMFAgARHkoD6RpFfS8kNgQEiYNu2ZbswsuBm2hf",
        },
        .blip = .{
            .url = "git+https://github.com/pmarreck/BLIP#2855eb88743b505bd3c90df8e0b7857cc305cb42",
            .hash = "blip-0.1.0-rcNuGAOaBwC6_peTLnpRQWj7CBmiSqsMuItS6C4at5ED",
        },
        // mini_blar extracted from BLIP to its own repo; consume its module directly.
        .mini_blar = .{
            .url = "git+https://github.com/pmarreck/mini_blar#e1dd0b8f30bfbb4281af3fcdc794a10b77a7bd34",
            .hash = "mini_blar-3.0.0-3792nNzwAQD17kS0jQfrf-IQ9Z8qfQ-kj2mdEBPlOWuu",
        },
        // tiffz: cleanroom pure-Zig TIFF / DNG / NEF / NRW / CR2 / ARW
        // structural validator. Owns the jpegz pin and re-exports it as
        // `tiffz.jpegz`, so validate consumes a SINGLE jpegz module instance
        // through tiffz. Depending on jpegz directly here too created a second
        // jpegz module instance sharing the same root file, which Zig 0.16
        // rejects ("file exists in modules 'jpegz' and 'jpegz0'") and the nix
        // sandbox SEGVs on during the Debug test compile. See validate #32.
        .tiffz = .{
            .url = "git+https://github.com/pmarreck/tiffz#ac381e6420c6ec91981bafce9b0123cfc8f3d5d1",
            .hash = "tiffz-0.1.0-qutJATqqzwEUrMNfzSQrfaGeDHSUxklBWRtgExdg63eN",
        },
        // rawz: proprietary camera-RAW vendor semantics (PEF private Huffman,
        // packed-12, vendor classifiers). Consumed as a source module with
        // OUR tiffz_dep's "tiffz-parser" injected (one-instance rule — see
        // rawz's docs/validate_integration.md); rawz's own tiffz pin is
        // bypassed at module level and only fetched in the FOD.
        .rawz = .{
            .url = "https://github.com/pmarreck/rawz/archive/2d030cf71075f5e126e07eaa2ad0c1377798b946.tar.gz",
            .hash = "rawz-0.1.0-sAg3Opc2AQByM2uPDUcILtbUC0hqym4oFQnXet4xu8CJ",
        },
        .wavpack_src = .{
            .url = "https://github.com/dbry/WavPack/archive/refs/tags/5.9.0.tar.gz",
            .hash = "N-V-__8AAAZvRACqqks-KAMLJ7bhK0Ei0r-c4ox4dym2esGj",
        },
        .mac_sdk = .{
            .url = "https://monkeysaudio.com/files/MAC_1273_SDK.zip",
            .hash = "N-V-__8AACp7UgDfQ40ycIueba0O_UliBesYAn0HBgnBnFBZ",
        },
    },
    .paths = .{""},
    .fingerprint = 0x421232542dfe208d,
}
