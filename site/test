#!/usr/bin/env bash
# site/test — run all site generator tests; accumulate failures.
# NO set -e (commands under test legitimately return non-zero). set -u only.
set -u

SITE_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SITE_DIR" || exit 1

failures=0
lua_tests=0
bash_tests=0

# Lua unit tests
while IFS= read -r t; do
	[ -n "$t" ] || continue
	lua_tests=$((lua_tests + 1))
	out="$(luajit "$t" 2>&1)"
	rc=$?
	if [ $rc -eq 0 ]; then
		echo "PASS $t"
	else
		echo "FAIL $t (exit $rc)"
		echo "$out" | sed 's/^/  /'
		failures=$((failures + 1))
	fi
done < <(glob 'tests/test_*.lua')

# Bash integration tests (post-generate output assertions)
while IFS= read -r t; do
	[ -n "$t" ] || continue
	bash_tests=$((bash_tests + 1))
	out="$(bash "$t" 2>&1)"
	rc=$?
	if [ $rc -eq 0 ]; then
		echo "PASS $t"
	else
		echo "FAIL $t (exit $rc)"
		echo "$out" | sed 's/^/  /'
		failures=$((failures + 1))
	fi
done < <(glob 'tests/test_*.bash')

if [ "$lua_tests" -eq 0 ] || [ "$bash_tests" -eq 0 ]; then
	echo "FAIL site test discovery (Lua: $lua_tests, Bash: $bash_tests)"
	failures=$((failures + 1))
fi

echo ""
if [ $failures -eq 0 ]; then
	echo "site tests: ALL PASS"
else
	echo "site tests: $failures file(s) FAILED"
fi
exit $failures
